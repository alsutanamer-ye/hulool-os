{
  "name": "hulool-os",
  "version": "0.1.0",
  "description": "AI Agent Orchestration Platform - The OS for Zero-Human Companies",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "hulool": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "cli": "tsx src/cli/index.ts",
    "cli:build": "tsc && chmod +x dist/cli/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed/index.ts",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test:supabase": "tsx scripts/test-supabase.ts",
    "clean": "rm -rf dist node_modules/.cache",
    "templates:index": "tsx scripts/rebuild-template-index.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@types/inquirer": "9.0.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^1.6.1",
    "drizzle-kit": "^0.20.18",
    "eslint": "^8.57.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^8.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.118.0",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.29.5",
    "fastify": "^4.29.1",
    "inquirer": "^9.3.8",
    "openai": "^7.45.1",
    "ora": "^8.2.0",
    "pg": "^8.23.1",
    "postgres": "^4.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  }
}