# ========================================
# Hulool OS - Environment Configuration
# ========================================
# انسخ هذا الملف إلى .env وعدّل القيم

# Default LLM Provider
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4

# Storage Mode (json or supabase)
HULOOl_STORAGE=json

# Supabase (Optional - for cloud storage)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key

# API Keys (Use `hulool secrets set` instead of storing here)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Dashboard
DASHBOARD_PORT=4000

# MCP Server
MCP_SERVER_PORT=3000
